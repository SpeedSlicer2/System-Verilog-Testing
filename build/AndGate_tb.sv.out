S_0x55924a67b550 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55924a67b6e0 .scope module, "AndGate_tb" "AndGate_tb" 3 1;
 .timescale 0 0;
v0x55924a6c81d0_0 .var "a", 7 0;
v0x55924a6c8290_0 .var "b", 7 0;
v0x55924a6c8330_0 .var/i "fd", 31 0;
